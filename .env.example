# THIS ENV FILE WILL BE PICKED UP BY DOCKER AND WILL NOT BE USED WHEN RUNNING WITH NPM (npm run dev)
# CONTAINER TO CONTAINER REQUESTS NEED TO BE DONE VIA http://container:port

# Better Auth
BETTER_AUTH_SECRET=your-secret-key # Generate with: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_API_KEY=ba_some_api_key # Better Auth Dashboard API key (https://better-auth.com/docs/infrastructure/plugins/dashboard)

# CORS
NEXT_PUBLIC_API_URL=http://localhost:3001 # Public-facing API URL (used by the browser)
NEXT_PUBLIC_WEB_URL=http://localhost:3000 # Public-facing web app URL
SERVER_API_URL=http://api:3001 # Internal API URL (targets the API container in Docker)

TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001 # Comma-separated list of allowed origins
WEB_ORIGIN=http://localhost:3000

# Cookies
COOKIE_DOMAIN= # Leave empty for localhost, set to your domain in production (e.g. .example.com)

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
TELEMETRY_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN=http # Use stable HTTP semantic conventions (http.server.request.duration etc.)

# Database
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql://rmanager:your-postgres-password@postgres:5432/rmanager # Must match POSTGRES_PASSWORD

# Email
GMAIL_APP_PASSWORD=your-gmail-app-password # Generate at: https://myaccount.google.com/apppasswords
GMAIL_EMAIL_ADDRESS=your-email@gmail.com

# Self Managed Security
MASTER_ENCRYPTION_KEY=your-master-encryption-key # Generate with: openssl rand -hex 32

# Runtime
API_PORT=3001 # The port on which Hono should run
NODE_ENV=production # Running in docker = production
